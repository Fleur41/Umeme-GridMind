# Copy to .env and replace the placeholders. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

POSTGRES_DB=gridmind
POSTGRES_USER=gridmind
POSTGRES_PASSWORD=replace-with-a-strong-password

# Optional: when set, POST/PATCH requests need header X-GridMind-Token with this value.
GRIDMIND_WRITE_TOKEN=

# Local development without Docker uses SQLite unless DATABASE_URL is set, e.g.
# DATABASE_URL=postgres://gridmind:password@localhost:5432/gridmind
